{
  "name": "dsh-proteus-bridge",
  "displayName": "DSH Proteus Bridge",
  "description": "让 Harness Agent 通过 COM 控制 Proteus 8/9 交互仿真并编辑原理图：仿真生命周期、信号读取、元件放置、引脚查询、导线连接与工程保存。",
  "version": "0.4.0",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "proteus",
    "eda",
    "simulation",
    "schematic"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "whitelist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}