{
  "name": "dsh-proteus-bridge",
  "displayName": "DSH Proteus Bridge",
  "description": "让 Harness Agent 控制 Proteus 8/9 交互仿真并保存工程：仿真生命周期、状态探测、工程保存、布局建议。无 COM 时自动降级到 UI 传输（Win32 键盘驱动）。",
  "version": "0.4.2",
  "license": "MIT",
  "author": "hualuo520-h",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hualuo520-h/dsh-proteus-bridge.git"
  },
  "homepage": "https://github.com/hualuo520-h/dsh-proteus-bridge#readme",
  "bugs": {
    "url": "https://github.com/hualuo520-h/dsh-proteus-bridge/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "proteus",
    "eda",
    "simulation",
    "schematic"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "whitelist",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/session.js && node --check lib/ui/uibroker.js && node --check lib/layout.js && node --check lib/errors.js",
    "test": "node test/selfcheck.mjs"
  }
}
